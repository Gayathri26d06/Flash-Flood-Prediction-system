# Frontend (Vite) environment variables.
# Copy this file to .env — never commit a real .env.
# Only variables prefixed with VITE_ are exposed to the browser,
# so never put secrets (DB passwords, API keys) in here.

# Base URL of the Node.js/Express backend REST API.
VITE_API_URL=http://localhost:5000/api

# Socket.IO server URL. If omitted, it is derived from VITE_API_URL
# by stripping the trailing /api.
VITE_SOCKET_URL=http://localhost:5000

# Dev-only: when true, API calls fall back to src/services/mockData.js
# if the backend is unreachable, so the UI is demoable standalone.
# Set to false when running against the real backend.
VITE_USE_MOCK_DATA=false
