# Copy this file to .env if you want to override defaults.
# Never commit a real .env.

PORT=8000

# --- Manual AI Disaster Check risk banding (optional) ---
# Maps the prototype classifier's 0-100 probability onto a risk level.
# Defaults shown below. Set MANUAL_RISK_CRITICAL_THRESHOLD=101 to disable
# the CRITICAL tier and cap the output at HIGH (original 3-tier behaviour).
MANUAL_RISK_CRITICAL_THRESHOLD=85
MANUAL_RISK_HIGH_THRESHOLD=70
MANUAL_RISK_MODERATE_THRESHOLD=40
