# Copy this file to .env and fill in real values.
# Never commit the actual .env file with real credentials.

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flood_prediction

ML_SERVICE_URL=http://localhost:8000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Timeout (ms) for calls to the ML service before treating it as unavailable
ML_SERVICE_TIMEOUT_MS=5000

# --- Location-Controlled Flash Flood Intelligence additions ---
# OpenStreetMap Nominatim geocoding endpoint (global location search).
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Required by Nominatim's usage policy — identify your app + contact.
GEOCODER_USER_AGENT=FlashFloodPredictionSystem/1.0 (contact: you@example.com)

# Open-Meteo endpoints (weather/soil + GloFAS river discharge).
# Free, keyless, public APIs — no official IMD/CWC affiliation.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood

